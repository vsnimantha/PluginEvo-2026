struct Box {
    int value;
    Box(int v) : value(v) {}
    Box(const Box &other) : value(other.value + 1) {}
    Box(Box &&other) noexcept : value(other.value + 10) {}
    Box &operator=(const Box &other) {
        if (this != &other) value = other.value + 2;
        return *this;
    }
    Box &operator=(Box &&other) noexcept {
        if (this != &other) value = other.value + 20;
        return *this;
    }
};


