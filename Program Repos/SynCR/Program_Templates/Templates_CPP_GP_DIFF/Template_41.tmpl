#include <iostream>
#include <stdlib.h>
#include <cstdio>
using namespace std;

template<int N>
int sum_array(const int (&a)[N]) {
    int s = 0;
    for (int i = 0; i < N; ++i) s += a[i] * (i + 1);
    return s;
}


