struct Vec2 {
    int x, y;
};

Vec2 operator+(const Vec2 &a, const Vec2 &b) {
    return {a.x + b.x, a.y + b.y};
}

Vec2 operator*(const Vec2 &v, int k) {
    return {v.x * k, v.y * k};
}

int dot(const Vec2 &a, const Vec2 &b) {
    return a.x * b.x + a.y * b.y;
}

