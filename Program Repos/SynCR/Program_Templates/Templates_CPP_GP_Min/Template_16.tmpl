int main() {
    
    int a[5]  = {1, 2, 3, 4, 5};
    bool b[5] = {true, false, true, true, false};

    int r1 = Accum<int>::apply(a, 5);
    int r2 = Accum<bool>::apply(b, 5);

    std::cout << r1 * 10 + r2;

