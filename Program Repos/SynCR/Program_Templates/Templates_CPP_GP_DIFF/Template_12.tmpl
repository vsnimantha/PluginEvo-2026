//Vectorization-friendly loop
#include <iostream>
#include <cstdio>
#include <stdio.h>
using namespace std;


int main() {
const int N = 16;
    float a[N], b[N], c[N];

    for (int i = 0; i < N; ++i) {
        a[i] = i + 1.0f;
        b[i] = (N - i) * 0.5f;
    }

    // Candidate for vectorization.
    for (int i = 0; i < N; ++i) {
        c[i] = a[i] * b[i] + 1.0f;
    }

    float sum = 0.0f;
    for (int i = 0; i < N; ++i) {
        sum += c[i];
    }

    // Convert to stable integer.
    int result = static_cast<int>(sum * 1000.0f + 0.5f);
    std::cout << result;

