// Template_16.tmpl
#include <iostream>
#include <functional>
#include <cstdio>

using namespace std;

template <typename T>
struct Accum {
    static int apply(const T *data, int n) {
        int s = 0;
        for (int i = 0; i < n; ++i) s += data[i];
        return s;
    }
};

template <>
struct Accum<bool> {
    static int apply(const bool *data, int n) {
        int s = 0;
        for (int i = 0; i < n; ++i) s += data[i] ? 2 : -1;
        return s;
    }
};

