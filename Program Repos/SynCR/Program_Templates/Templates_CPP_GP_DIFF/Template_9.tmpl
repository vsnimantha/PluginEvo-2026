        Box a(5);          // value = 5
    Box b = a;         // copy: value = 6
    Box c = std::move(a); // move: value = 15
    b = c;             // copy assign: value = 17
    c = std::move(b);  // move assign: value = 37

    int result = a.value * 101 + b.value * 17 + c.value;
    std::cout << result;

