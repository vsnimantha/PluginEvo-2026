int tricky(int *p, int n) {
    int acc = 0;
    for (int i = 0; i < n; ++i) {
        int v = p[i] ^ (i << 1);
        if ((v & 1) == 0) {
            acc += v;
        } else {
            acc -= v;
        }
        if (acc == 13) {
            acc ^= i;
        }
    }
    return acc;
}

