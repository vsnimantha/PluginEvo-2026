//Class layout & inheritance
#include <iostream>
#include <cstdio>
#include <string>
#include <vector>

using namespace std;
struct Base {
    virtual int f(int x) const { return x + 1; }
    virtual ~Base() {}
};

struct Left : virtual Base {
    int f(int x) const override { return x + 3; }
};

struct Right : virtual Base {
    int f(int x) const override { return x * 2; }
};

struct Derived : Left, Right {
    int extra;
    Derived(int e) : extra(e) {}
    int f(int x) const override {
        // Intentional choice: call Right::f
        return Right::f(x) + extra;
    }
};

int dispatch(const Base &b, int start) {
    int res = 0;
    for (int i = 0; i < 5; ++i) {
        res = res * 13 + b.f(start + i);
    }
    return res;
}

